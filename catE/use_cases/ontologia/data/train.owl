        <untitled-ontology-27:Responde_a_pregunta rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#pregunta6"/>
        <untitled-ontology-27:Se_interpreta rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#idd22"/>
        <untitled-ontology-27:Valor>Consulto Wikipedia habitualmente para informarme de forma rápida. En caso de necesitar más profundidad busco otros sitios calificados. No tengo ningún sitio predilecto.</untitled-ontology-27:Valor>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#dato53 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#dato53">
        <rdf:type rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#registro"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#respuesta_a_entrevista"/>

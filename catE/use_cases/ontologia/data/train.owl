        <untitled-ontology-27:Se_interpreta rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#idd20"/>
        <untitled-ontology-27:Valor>En algún caso muy puntual donde algo no me ha quedado claro recurro a ver youtube para ver si algún usuario subió algo relacionado. Y a veces algún profesor de otro lado sube algo similar que permite orientarse respecto a autores en concreto muy pocas ocasiones, pero también he buscado.</untitled-ontology-27:Valor>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#dato51 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#dato51">
        <rdf:type rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#registro"/>
        <rdf:type rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#respuesta_a_entrevista"/>

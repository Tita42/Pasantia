        <untitled-ontology-27:Responde_a_pregunta rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#pregunta5"/>
        <untitled-ontology-27:Soportado_en rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#soporte1"/>
        <untitled-ontology-27:Valor>Para mí el futuro representa muchos objetivos y sueños por cumplir. Representa proyectos, viajes por realizar y seguir descubriéndose uno mismo.</untitled-ontology-27:Valor>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#dato50 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#dato50">
        <rdf:type rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#registro"/>

    <untitled-ontology-27:Soportado_en rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#soporte1"/>
    <untitled-ontology-27:Responde_a_pregunta rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#pregunta2"/>
  </rdf:Description>

  <rdf:Description rdf:about="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#dato12">
    <untitled-ontology-27:Responde_a_pregunta rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#pregunta12"/>

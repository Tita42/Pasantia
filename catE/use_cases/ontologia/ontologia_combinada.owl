  <rdf:Description rdf:about="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#ecd11.1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <untitled-ontology-27:categoria_superior rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#ecd11"/>
    <untitled-ontology-27:Valor>NO</untitled-ontology-27:Valor>

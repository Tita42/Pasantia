  <rdf:Description rdf:about="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#pregunta12">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <untitled-ontology-27:Valor>¿El uso y apropiación de dichas herramientas cambió por la situación de la pandemia? ¿Incorporaron el Zoom, u otra aplicación similar para reunirse, o ponerse de acuerdo?</untitled-ontology-27:Valor>
    <untitled-ontology-27:Es_de_entrevista rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#entrevista2"/>

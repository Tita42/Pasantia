    <untitled-ontology-27:Valor>¿Ha cambiado tu sistema de búsqueda y lectura de la información desde el inicio de la carrera? Explica de qué forma ha cambiado y por qué</untitled-ontology-27:Valor>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#dato10">
    <rdf:type rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#respuesta_a_entrevista"/>

    <untitled-ontology-27:Metadato rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#E19"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#registro"/>
    <untitled-ontology-27:Metadato rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#varón"/>
    <untitled-ontology-27:Metadato rdf:resource="http://www.semanticweb.org/emilio/ontologies/2024/5/untitled-ontology-27#Uruguay"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <untitled-ontology-27:Valor>A mí lo que me define como joven es ser parte de una generación que utiliza los mismos códigos para comunicarse y encontrarse en constante actualización de estos códigos en este contexto de adaptación inmediata y de “no quedarse atrás”</untitled-ontology-27:Valor>
  </rdf:Description>
